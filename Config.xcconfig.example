// Copy to Config.xcconfig (git-ignored) and fill in. Local values: `supabase status`.
// Hosted: https:/$()/<project-ref>.supabase.co and the project's anon (public) key. Never the service_role key.
// "//" starts a comment in xcconfig files, hence the $() between the slashes.
SUPABASE_URL = http:/$()/127.0.0.1:54321
SUPABASE_ANON_KEY = paste-the-anon-key-here
// Apple Developer Team ID (developer.apple.com → Membership details)
DEVELOPMENT_TEAM =
CODE_SIGN_STYLE = Automatic
